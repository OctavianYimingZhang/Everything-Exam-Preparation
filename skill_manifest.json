{
  "schema_version": 3,
  "plugin_version": "3.3.0",
  "skill_id": "everything-exam-preparation",
  "repo": "OctavianYimingZhang/Everything-Exam-Preparation",
  "branch": "main",
  "entrypoint": "SKILL.md",
  "multi_skill_system": true,
  "architecture": {
    "router": "everything-exam-preparation",
    "focused_skill_policy": "manifest_driven",
    "boundary_rule": "Split when learning intent, evidence role, workflow, toolchain, or output is materially independent; merge when those elements are shared."
  },
  "default_output": "docx",
  "default_output_language": "en",
  "result_contract": {
    "schema_version": "1.0",
    "statuses": [
      "completed",
      "completed_with_gaps",
      "needs_material_input",
      "source_conflict",
      "artifact_generated",
      "analysis_only"
    ],
    "artifact_required_fields": [
      "artifact_id",
      "artifact_type",
      "file_format",
      "content_schema_version",
      "source_corpus_ids",
      "qa_status"
    ]
  },
  "public_skills": [
    {
      "name": "everything-exam-preparation",
      "path": "skills/everything-exam-preparation/SKILL.md",
      "purpose": "intent_router"
    },
    {
      "name": "exam-prep-notes",
      "path": "skills/exam-prep-notes/SKILL.md",
      "purpose": "course_notes"
    },
    {
      "name": "exam-prep-practice",
      "path": "skills/exam-prep-practice/SKILL.md",
      "purpose": "question_based_practice"
    },
    {
      "name": "exam-prep-essay",
      "path": "skills/exam-prep-essay/SKILL.md",
      "purpose": "essay_support"
    }
  ],
  "references": [
    "references/input_and_evidence_protocol.md",
    "references/exam_prep_notes_protocol.md",
    "references/exam_mode_and_addons_protocol.md",
    "references/essay_exam_prep_protocol.md"
  ],
  "tools": {
    "sources": "scripts/extract_sources.py",
    "notes": "scripts/generate_exam_prep_notes_docx.py",
    "practice": "scripts/exam_mode_tools.py",
    "essay": "scripts/essay_exam_tools.py",
    "validation": "scripts/validate_skill_contracts.py",
    "installation": "scripts/publish_skill.py"
  },
  "removed_focused_skills": [
    "exam-prep-index",
    "exam-prep-slide-triage",
    "exam-prep-mcq",
    "exam-prep-short-answer",
    "exam-prep-long-answer",
    "exam-prep-worked-solutions",
    "exam-prep-online-essay-exam",
    "exam-prep-extra-reading",
    "exam-prep-question-solver",
    "exam-prep-question-organizer",
    "exam-prep-exam-mode"
  ],
  "publish": {
    "local_skill_update": "python3 scripts/publish_skill.py --sync-local-skill",
    "installed_drift_check": "python3 scripts/publish_skill.py --check-installed"
  }
}

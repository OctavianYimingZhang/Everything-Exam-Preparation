{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://example.invalid/everything-exam-preparation/visual_aid_spec.schema.json",
  "title": "Visual aid spec",
  "properties": {
    "source_id": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "image_path": {
      "type": "string"
    },
    "source_path": {
      "type": "string"
    },
    "media_name": {
      "type": "string"
    },
    "visual_kind": {
      "enum": [
        "source_image",
        "generated_schematic"
      ]
    },
    "caption": {
      "type": "string"
    },
    "max_width_inches": {
      "type": "number",
      "maximum": 3.8
    },
    "height_inches": {
      "type": "number"
    }
  }
}

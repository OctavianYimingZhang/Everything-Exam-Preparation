{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OctavianYimingZhang/Everything-Exam-Preparation/schemas/exam_intelligence_package.schema.json",
  "title": "Exam Intelligence Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_type", "public", "audit"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "package_type": {"const": "exam_intelligence"},
    "public": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "course_id",
        "course_title",
        "corpus_scope",
        "metric_definitions",
        "question_families",
        "limitations",
        "interpretation_guardrails"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["completed", "completed_with_gaps", "needs_material_input"]
        },
        "course_id": {"$ref": "#/$defs/nullableString"},
        "course_title": {"$ref": "#/$defs/nullableString"},
        "corpus_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_role_counts", "formal_years"],
          "properties": {
            "source_role_counts": {"$ref": "#/$defs/sourceRoleCounts"},
            "formal_years": {
              "type": "array",
              "items": {"type": "integer", "minimum": 1900, "maximum": 2200},
              "uniqueItems": true
            }
          }
        },
        "metric_definitions": {"$ref": "#/$defs/metricDefinitions"},
        "question_families": {
          "type": "array",
          "items": {"$ref": "#/$defs/questionFamily"}
        },
        "limitations": {
          "type": "array",
          "minItems": 3,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "interpretation_guardrails": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "formal_recurrence_basis",
            "weighting_inference_allowed",
            "certain_prediction_allowed",
            "composite_score_produced"
          ],
          "properties": {
            "formal_recurrence_basis": {"const": "formal_past_paper_only"},
            "weighting_inference_allowed": {"const": false},
            "certain_prediction_allowed": {"const": false},
            "composite_score_produced": {"const": false}
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "question_records",
        "family_memberships",
        "metric_evidence",
        "unresolved_mappings",
        "exclusions",
        "warnings"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {"$ref": "#/$defs/sourceRecord"}
        },
        "question_records": {
          "type": "array",
          "items": {"$ref": "#/$defs/questionRecord"}
        },
        "family_memberships": {
          "type": "array",
          "items": {"$ref": "#/$defs/familyMembership"}
        },
        "metric_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/metricEvidence"}
        },
        "unresolved_mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question_id", "reason"],
            "properties": {
              "question_id": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "exclusions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "warnings": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "nullableString": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "sourceRole": {
      "type": "string",
      "enum": [
        "formal_past_paper",
        "official_mock_specimen",
        "practice_worksheet",
        "lecture_material",
        "mark_scheme"
      ]
    },
    "sourceRoleCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_past_paper",
        "official_mock_specimen",
        "practice_worksheet",
        "lecture_material",
        "mark_scheme"
      ],
      "properties": {
        "formal_past_paper": {"type": "integer", "minimum": 0},
        "official_mock_specimen": {"type": "integer", "minimum": 0},
        "practice_worksheet": {"type": "integer", "minimum": 0},
        "lecture_material": {"type": "integer", "minimum": 0},
        "mark_scheme": {"type": "integer", "minimum": 0}
      }
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_name",
        "source_role",
        "formal_year",
        "source_locator",
        "locator_status"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_name": {"type": "string", "minLength": 1},
        "source_role": {"$ref": "#/$defs/sourceRole"},
        "formal_year": {
          "oneOf": [
            {"type": "integer", "minimum": 1900, "maximum": 2200},
            {"type": "null"}
          ]
        },
        "source_locator": {"type": "string", "minLength": 1},
        "locator_status": {"type": "string", "enum": ["complete", "incomplete"]}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "lecture_id",
        "unit_id",
        "concept_ids",
        "evidence",
        "unresolved_reason"
      ],
      "properties": {
        "status": {"type": "string", "enum": ["resolved", "unresolved"]},
        "lecture_id": {"$ref": "#/$defs/nullableString"},
        "unit_id": {"$ref": "#/$defs/nullableString"},
        "concept_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "unresolved_reason": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "resolved"}}},
          "then": {
            "properties": {
              "evidence": {"minItems": 1},
              "unresolved_reason": {"type": "null"}
            },
            "anyOf": [
              {"properties": {"lecture_id": {"type": "string", "minLength": 1}}},
              {"properties": {"unit_id": {"type": "string", "minLength": 1}}},
              {"properties": {"concept_ids": {"minItems": 1}}}
            ]
          }
        },
        {
          "if": {"properties": {"status": {"const": "unresolved"}}},
          "then": {
            "properties": {
              "lecture_id": {"type": "null"},
              "unit_id": {"type": "null"},
              "concept_ids": {"maxItems": 0},
              "unresolved_reason": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "questionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "source_id",
        "source_name",
        "source_role",
        "source_locator",
        "locator_status",
        "formal_year",
        "question_text",
        "question_format",
        "explicit_marks",
        "family_id",
        "mapping"
      ],
      "properties": {
        "question_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "source_name": {"type": "string", "minLength": 1},
        "source_role": {"$ref": "#/$defs/sourceRole"},
        "source_locator": {"type": "string", "minLength": 1},
        "locator_status": {"type": "string", "enum": ["complete", "incomplete"]},
        "formal_year": {
          "oneOf": [
            {"type": "integer", "minimum": 1900, "maximum": 2200},
            {"type": "null"}
          ]
        },
        "question_text": {"type": "string", "minLength": 1},
        "question_format": {
          "type": "string",
          "enum": [
            "mcq",
            "short_answer",
            "long_answer",
            "calculation",
            "data_interpretation",
            "essay",
            "other"
          ]
        },
        "explicit_marks": {
          "oneOf": [
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "null"}
          ]
        },
        "family_id": {"$ref": "#/$defs/nullableString"},
        "mapping": {"$ref": "#/$defs/mapping"}
      }
    },
    "questionFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "title",
        "description",
        "formal_occurrence_count",
        "distinct_formal_years",
        "formal_year_coverage",
        "auxiliary_occurrence_count",
        "format_diversity",
        "explicit_mark_exposure",
        "retention",
        "cross_year_stability",
        "mapping_coverage",
        "unresolved_mapping_count"
      ],
      "properties": {
        "family_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "formal_occurrence_count": {"type": "integer", "minimum": 0},
        "distinct_formal_years": {"type": "integer", "minimum": 0},
        "formal_year_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "auxiliary_occurrence_count": {"type": "integer", "minimum": 0},
        "format_diversity": {"type": "integer", "minimum": 0},
        "explicit_mark_exposure": {"type": "number", "minimum": 0},
        "retention": {"type": "number", "minimum": 0, "maximum": 1},
        "cross_year_stability": {"type": "number", "minimum": 0, "maximum": 1},
        "mapping_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "unresolved_mapping_count": {"type": "integer", "minimum": 0}
      }
    },
    "metricDefinitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_occurrence_count",
        "distinct_formal_years",
        "formal_year_coverage",
        "auxiliary_occurrence_count",
        "format_diversity",
        "explicit_mark_exposure",
        "retention",
        "cross_year_stability",
        "mapping_coverage",
        "unresolved_mapping_count"
      ],
      "properties": {
        "formal_occurrence_count": {"type": "string", "minLength": 1},
        "distinct_formal_years": {"type": "string", "minLength": 1},
        "formal_year_coverage": {"type": "string", "minLength": 1},
        "auxiliary_occurrence_count": {"type": "string", "minLength": 1},
        "format_diversity": {"type": "string", "minLength": 1},
        "explicit_mark_exposure": {"type": "string", "minLength": 1},
        "retention": {"type": "string", "minLength": 1},
        "cross_year_stability": {"type": "string", "minLength": 1},
        "mapping_coverage": {"type": "string", "minLength": 1},
        "unresolved_mapping_count": {"type": "string", "minLength": 1}
      }
    },
    "familyMembership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "title",
        "description",
        "member_question_ids",
        "clustering_method",
        "manual_review_required"
      ],
      "properties": {
        "family_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "member_question_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "clustering_method": {
          "type": "string",
          "enum": [
            "explicit_family",
            "explicit_mapping",
            "deterministic_similarity",
            "singleton_unresolved"
          ]
        },
        "manual_review_required": {"type": "boolean"}
      }
    },
    "metricEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "formal_question_ids",
        "formal_years",
        "annual_formal_counts",
        "auxiliary_question_ids",
        "observed_formats",
        "explicitly_marked_question_ids",
        "mapped_question_ids",
        "unresolved_question_ids"
      ],
      "properties": {
        "family_id": {"type": "string", "minLength": 1},
        "formal_question_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "formal_years": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1900, "maximum": 2200},
          "uniqueItems": true
        },
        "annual_formal_counts": {
          "type": "object",
          "propertyNames": {"pattern": "^(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)$"},
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "auxiliary_question_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "observed_formats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mcq",
              "short_answer",
              "long_answer",
              "calculation",
              "data_interpretation",
              "essay",
              "other"
            ]
          },
          "uniqueItems": true
        },
        "explicitly_marked_question_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "mapped_question_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "unresolved_question_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}

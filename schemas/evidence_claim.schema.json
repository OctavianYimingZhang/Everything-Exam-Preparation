{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://example.invalid/everything-exam-preparation/evidence_claim.schema.json",
  "title": "Evidence claim",
  "properties": {
    "claim": {
      "type": "string"
    },
    "source_ids": {
      "type": "array"
    },
    "support_level": {
      "enum": [
        "supported",
        "partial",
        "unsupported"
      ]
    }
  },
  "required": [
    "claim",
    "support_level"
  ]
}

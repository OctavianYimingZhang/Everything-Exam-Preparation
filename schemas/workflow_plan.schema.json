{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://example.invalid/everything-exam-preparation/workflow_plan.schema.json",
  "title": "Workflow plan",
  "properties": {
    "route": {
      "enum": [
        "exam_prep_notes",
        "exam_mode_diagnosis",
        "mcq_addon",
        "short_answer_addon",
        "long_answer_practical_addon",
        "essay_addon",
        "source_inventory_only",
        "audit_lint_only",
        "github_ready_qa"
      ]
    },
    "ordering": {
      "enum": [
        "exam_emphasis_first",
        "source_order"
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {"action": {"type": "object", "required": ["id", "purpose"], "properties": {"id": {"type": "string"}, "purpose": {"type": "string"}}}}
}

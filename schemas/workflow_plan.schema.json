{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://example.invalid/everything-exam-preparation/workflow_plan.schema.json",
  "title": "Workflow plan",
  "properties": {
    "route": {
      "enum": [
        "exam_prep_notes",
        "exam_mode_diagnosis",
        "mcq_addon",
        "short_answer_addon",
        "long_answer_practical_addon",
        "essay_addon",
        "source_inventory_only",
        "audit_lint_only",
        "github_ready_qa"
      ]
    },
    "ordering": {
      "enum": [
        "exam_emphasis_first",
        "source_order"
      ]
    },
    "output": {
      "enum": [
        "Exam_Preparation_Notes.docx",
        "Example_Essay.docx",
        "chat_report"
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "enum": [
          "Exam_Preparation_Notes.docx",
          "Example_Essay.docx",
          "chat_report"
        ]
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "source_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "route",
    "ordering",
    "output",
    "outputs",
    "actions"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "route": {
            "const": "essay_addon"
          }
        },
        "required": [
          "route"
        ]
      },
      "then": {
        "properties": {
          "outputs": {
            "contains": {
              "const": "Example_Essay.docx"
            }
          }
        }
      }
    }
  ],
  "$defs": {"action": {"type": "object", "required": ["id", "purpose"], "properties": {"id": {"type": "string"}, "purpose": {"type": "string"}}}}
}

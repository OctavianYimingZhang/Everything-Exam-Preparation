{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/everything-exam-preparation/exam_prep_notes_plan.schema.json",
  "title": "Exam Preparation Notes plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "ordering": {
      "enum": [
        "exam_emphasis_first",
        "source_order"
      ]
    },
    "visual_policy": {
      "enum": [
        "block_level_only",
        "text_only_with_skip_reason"
      ]
    },
    "source_decision_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visual_decisions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selected_visual_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skip_reason": {
          "type": "string"
        }
      }
    },
    "visuals": {
      "type": "array",
      "items": {
        "$ref": "visual_aid_spec.schema.json"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "required": [
    "title",
    "ordering",
    "visual_policy",
    "sections"
  ],
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "type": "string",
          "minLength": 1
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "required": [
        "section_id",
        "heading",
        "blocks"
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "render_mode": {
          "enum": [
            "kp_list",
            "compact_table",
            "mechanism_chain",
            "image_plus_kp_list",
            "paragraph"
          ]
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "paragraph": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "table": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "chain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visual_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "block_id",
        "heading",
        "render_mode",
        "source_ids"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "render_mode": {
                "const": "image_plus_kp_list"
              }
            },
            "required": [
              "render_mode"
            ]
          },
          "then": {
            "required": [
              "visual_ids",
              "points"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "render_mode": {
                "const": "compact_table"
              }
            },
            "required": [
              "render_mode"
            ]
          },
          "then": {
            "required": [
              "table"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "render_mode": {
                "const": "mechanism_chain"
              }
            },
            "required": [
              "render_mode"
            ]
          },
          "then": {
            "required": [
              "chain"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "render_mode": {
                "const": "paragraph"
              }
            },
            "required": [
              "render_mode"
            ]
          },
          "then": {
            "required": [
              "paragraph"
            ]
          }
        }
      ]
    }
  }
}

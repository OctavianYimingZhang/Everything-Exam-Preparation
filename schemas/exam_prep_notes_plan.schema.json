{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/everything-exam-preparation/exam_prep_notes_plan.schema.json",
  "title": "Exam Preparation Notes plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "ordering": {
      "enum": [
        "exam_emphasis_first",
        "source_order"
      ]
    },
    "visual_policy": {
      "enum": [
        "auto_source_visuals",
        "user_requested_text_only"
      ]
    },
    "source_decision_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visual_decisions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selected_visual_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "selected_count": {
          "type": "integer",
          "minimum": 0
        },
        "user_requested_text_only": {
          "type": "boolean"
        },
        "rejected_visuals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "visual_id": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 8
              }
            },
            "required": [
              "visual_id",
              "reason"
            ]
          }
        },
        "skip_reason": {
          "type": "string"
        }
      },
      "required": [
        "candidate_count",
        "selected_count",
        "user_requested_text_only"
      ]
    },
    "visuals": {
      "type": "array",
      "items": {
        "$ref": "visual_aid_spec.schema.json"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "required": [
    "title",
    "ordering",
    "visual_policy",
    "visual_decisions",
    "sections"
  ],
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 8
        },
        "exam_use": {
          "type": "string"
        },
        "limitation": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "explanation"
      ]
    },
    "compact_table": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "headers",
        "rows"
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "type": "string",
          "minLength": 1
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "required": [
        "section_id",
        "heading",
        "blocks"
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "render_mode": {
          "enum": [
            "kp_list",
            "compact_table",
            "mechanism_chain",
            "image_plus_kp_list",
            "paragraph"
          ]
        },
        "listability_reason": {
          "enum": [
            "source_numbered_list",
            "source_bulleted_list",
            "past_paper_list_question",
            "criteria_set",
            "taxonomy_or_contrast",
            "short_answer_mark_points",
            "definition_group",
            "not_listable"
          ]
        },
        "exam_prompt_signal": {
          "type": "string"
        },
        "source_form_signal": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "evidence_scope": {
          "enum": [
            "factual_course_content",
            "exam_emphasis"
          ]
        },
        "paragraph": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "table": {
          "$ref": "#/$defs/compact_table"
        },
        "chain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visual_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "block_id",
        "heading",
        "render_mode",
        "listability_reason",
        "source_ids"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "listability_reason": {
                "enum": [
                  "source_numbered_list",
                  "source_bulleted_list",
                  "past_paper_list_question",
                  "criteria_set",
                  "taxonomy_or_contrast",
                  "short_answer_mark_points",
                  "definition_group"
                ]
              }
            },
            "required": [
              "listability_reason"
            ]
          },
          "then": {
            "properties": {
              "render_mode": {
                "enum": [
                  "kp_list",
                  "compact_table",
                  "image_plus_kp_list"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "render_mode": {
                "const": "image_plus_kp_list"
              }
            },
            "required": [
              "render_mode"
            ]
          },
          "then": {
            "required": [
              "visual_ids",
              "points"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "render_mode": {
                "const": "compact_table"
              }
            },
            "required": [
              "render_mode"
            ]
          },
          "then": {
            "required": [
              "table"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "render_mode": {
                "const": "mechanism_chain"
              }
            },
            "required": [
              "render_mode"
            ]
          },
          "then": {
            "required": [
              "chain"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "render_mode": {
                "const": "paragraph"
              }
            },
            "required": [
              "render_mode"
            ]
          },
          "then": {
            "required": [
              "paragraph"
            ]
          }
        }
      ]
    }
  }
}

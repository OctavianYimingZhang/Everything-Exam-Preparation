{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://example.invalid/everything-exam-preparation/run_control_plane.schema.json",
  "title": "Run control plane",
  "properties": {
    "run_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_id",
          "object_type"
        ],
        "properties": {
          "object_id": {
            "type": "string"
          },
          "object_type": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "source_ids": {
            "type": "array"
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_id",
          "to_id",
          "link_type"
        ],
        "properties": {
          "from_id": {
            "type": "string"
          },
          "to_id": {
            "type": "string"
          },
          "link_type": {
            "type": "string"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "lineage_events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reuse_decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "run_id",
    "status",
    "objects",
    "links",
    "lineage_events",
    "validation_errors"
  ]
}
